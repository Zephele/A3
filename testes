import pandas as pd

# 1. Carregar os ficheiros CSV
df_prefeitos = pd.read_csv("bq-results.csv") # Ajuste o nome se necessário
df_ideb = pd.read_csv("br_inep_ideb_municipio.csv")

# 2. Converter IDs para String
df_prefeitos['id_municipio'] = df_prefeitos['id_municipio'].astype(str)
df_ideb['id_municipio'] = df_ideb['id_municipio'].astype(str)

# 3. Filtrar APENAS prefeitos eleitos
df_eleitos = df_prefeitos[
    (df_prefeitos['cargo'].str.lower() == 'prefeito') & 
    (df_prefeitos['resultado'].str.lower().str.contains('eleito')) &
    (~df_prefeitos['resultado'].str.lower().str.contains('nao eleito'))
].copy()

# 4. Mapear o Ano da Eleição para os Anos do Mandato
# Exemplo: Eleição 2016 -> Mandato 2017, 2018, 2019, 2020
mandatos = []
for _, row in df_eleitos.iterrows():
    ano_eleicao = row['ano']
    for ano_mandato in range(ano_eleicao + 1, ano_eleicao + 5):
        mandatos.append({
            'id_municipio': row['id_municipio'],
            'sigla_uf': row['sigla_uf'],
            'ano': ano_mandato,
            'sigla_partido': row['sigla_partido']
        })

df_mandatos = pd.DataFrame(mandatos)

# 5. Cruzar a base de mandatos com os dados do Ideb
df_merged = pd.merge(
    df_mandatos,
    df_ideb,
    on=['id_municipio', 'ano'],
    how='inner'
)

print("\n--- BASE CRUZADA COM SUCESSO ---")
print(f"Total de registos cruzados: {len(df_merged)}")
print(df_merged[['ano', 'sigla_uf_x', 'id_municipio', 'sigla_partido', 'ideb', 'rede']].head(10))

# 6. Salvar o dataset pronto para o modelo ML
df_merged.to_csv("dataset_processado_a3.csv", index=False)
print("\nDataset salvo como 'dataset_processado_a3.csv'!")


