import pandas as pd
import numpy as np

# 1. Carregar a base cruzada
df = pd.read_csv("dataset_processado_a3.csv")

# 2. Filtrar apenas pela Rede Municipal e remover notas nulas (NaN)
df_clean = df[
    (df['rede'] == 'municipal') & 
    (df['ideb'].notna())
].copy()

# 3. Remover duplicados se houver e manter colunas relevantes
colunas_relevantes = ['ano', 'sigla_uf_x', 'id_municipio', 'sigla_partido', 'ideb', 'taxa_aprovacao']
# Mantém apenas colunas existentes no dataset
colunas_presentes = [c for c in colunas_relevantes if c in df_clean.columns]
df_model = df_clean[colunas_presentes].dropna().drop_duplicates()

print(f"Total de linhas prontas para o modelo: {len(df_model)}")
print("\nDistribuição dos partidos na base limpa:")
print(df_model['sigla_partido'].value_counts().head(10))

# 4. Salvar base final de treino
df_model.to_csv("base_treino_model.csv", index=False)
print("\nBase de treino salva como 'base_treino_model.csv'!")
